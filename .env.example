HOST=0.0.0.0
PORT=8000
OUTPUT_DIR=./output
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
MESHY_API_KEY=your-meshy-api-key-here

# ── Local (on-device) image generation — optional ────────────────────────────
# Only active with the extras from requirements-local.txt installed and at
# least one .safetensors checkpoint in LOCAL_MODELS_DIR. See
# design-specs/local-image-generation.md.
LOCAL_MODELS_DIR=./models
LOCAL_DEVICE=auto
LOCAL_STEPS=35
LOCAL_GUIDANCE=7.0
# Sampler: dpm++2m_karras (default) | dpm++2m | euler_a | euler | unipc | ddim | pndm
LOCAL_SAMPLER=dpm++2m_karras
# Quality-floor negatives, composed with any the caller sends. Set "" to disable.
LOCAL_NEGATIVE_PROMPT=bad hands, mutated hands, fused fingers, extra fingers, missing fingers, extra limbs, missing limbs, malformed limbs, bad anatomy, bad proportions, deformed, disfigured, poorly drawn face, worst quality, low quality, blurry, watermark, signature, text, cropped
# Hires fix: render at native size, then upscale + short img2img pass.
# The pixel ceiling is what decides who gets it — at 900000, SD 1.5 does and
# SDXL is skipped (its faces already resolve, and the pass would add ~85s).
LOCAL_HIRES_SCALE=1.5
LOCAL_HIRES_DENOISE=0.40
LOCAL_HIRES_MAX_PIXELS=900000
# Run the VAE in fp32. Applies to SDXL only — SD 1.5's pipeline does no dtype
# reconciliation before decode and its VAE is fine in fp16 anyway.
LOCAL_VAE_FP32=1
